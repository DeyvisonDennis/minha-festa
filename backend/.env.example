# Banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/Minha_Festa?schema=public"

# JWT — Access Token (curta duração)
JWT_ACCESS_SECRET="gere_com_o_comando_abaixo"
JWT_ACCESS_EXPIRATION="15m"

# JWT — Refresh Token (longa duração)
JWT_REFRESH_SECRET="gere_com_o_comando_abaixo"
JWT_REFRESH_EXPIRATION="7d"

# Gere os dois segredos acima com:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# E-mail (Gmail SMTP) — usado para recuperação de senha
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="seu-email-do-sistema@gmail.com"
EMAIL_PASSWORD="senha_de_app_de_16_caracteres"
EMAIL_FROM="Minha Festa <seu-email-do-sistema@gmail.com>"

# URL do frontend (usada para montar links em e-mails)
FRONTEND_URL="http://localhost:3000"

# Segredo para hash do token de redefinição de senha
PASSWORD_RESET_SECRET="gere_com_o_mesmo_comando_acima"

# Google OAuth — obtenha em https://console.cloud.google.com
GOOGLE_CLIENT_ID="seu_client_id"
GOOGLE_CLIENT_SECRET="seu_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"