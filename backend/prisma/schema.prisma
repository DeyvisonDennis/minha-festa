  updated_at   DateTime     @default(now()) @db.Timestamptz(6)
  sites_evento sites_evento @relation(fields: [site_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([site_id, ordem], map: "idx_blocos_site")
}

