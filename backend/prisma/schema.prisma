}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id                                                         String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                                                       String                     @db.VarChar(150)
  cpf                                                        String?                    @unique @db.VarChar(11)
  email                                                      String                     @unique @db.Citext
  senha_hash                                                 String                     @db.VarChar(255)
  telefone                                                   String?                    @db.VarChar(20)
  perfil                                                     perfil_usuario             @default(ORGANIZADOR)
  email_confirmado                                           Boolean                    @default(false)
  ativo                                                      Boolean                    @default(true)
  consentimento_lgpd                                         Boolean                    @default(false)
  data_consentimento_lgpd                                    DateTime?                  @db.Timestamptz(6)
  ultimo_login                                               DateTime?                  @db.Timestamptz(6)
  criado_em                                                  DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                                                 DateTime                   @default(now()) @db.Timestamptz(6)
  excluido_em                                                DateTime?                  @db.Timestamptz(6)
  avaliacoes_fornecedores                                    avaliacoes_fornecedores[]
  consentimentos_lgpd                                        consentimentos_lgpd[]
  eventos                                                    eventos[]
  fornecedores_fornecedores_usuario_idTousuarios             fornecedores?              @relation("fornecedores_usuario_idTousuarios")
  fornecedores_fornecedores_validado_porTousuarios           fornecedores[]             @relation("fornecedores_validado_porTousuarios")
  logs_auditoria                                             logs_auditoria[]
  notificacoes                                               notificacoes[]
  sessoes_usuario                                            sessoes_usuario[]
  solicitacoes_lgpd_solicitacoes_lgpd_atendido_porTousuarios solicitacoes_lgpd[]        @relation("solicitacoes_lgpd_atendido_porTousuarios")
  solicitacoes_lgpd_solicitacoes_lgpd_usuario_idTousuarios   solicitacoes_lgpd[]        @relation("solicitacoes_lgpd_usuario_idTousuarios")
  tarefas                                                    tarefas[]
  tokens_confirmacao_email                                   tokens_confirmacao_email[]
  tokens_recuperacao_senha                                   tokens_recuperacao_senha[]

  @@index([email_confirmado], map: "idx_usuarios_email_confirmado")
  @@index([perfil], map: "idx_usuarios_perfil")
}

