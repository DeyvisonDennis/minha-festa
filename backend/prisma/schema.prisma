generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assinaturas_fornecedor {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fornecedor_id         String                  @unique(map: "uq_assinatura_ativa_fornecedor", where: raw("(status = ANY (ARRAY['ATIVA'::status_assinatura, 'PENDENTE'::status_assinatura]))")) @db.Uuid
  valor_mensal          Decimal                 @default(5.00) @db.Decimal(10, 2)
  status                status_assinatura       @default(PENDENTE)
  inicio_em             DateTime?               @db.Date
  fim_em                DateTime?               @db.Date
  proxima_cobranca      DateTime?               @db.Date
  cancelada_em          DateTime?               @db.Timestamptz(6)
  gateway               String?                 @db.VarChar(50)
  gateway_assinatura_id String?                 @db.VarChar(150)
  criado_em             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  fornecedores          fornecedores            @relation(fields: [fornecedor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pagamentos_fornecedor pagamentos_fornecedor[]

  @@index([fornecedor_id], map: "idx_assinaturas_fornecedor")
  @@index([status], map: "idx_assinaturas_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model avaliacoes_fornecedores {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fornecedor_id  String       @db.Uuid
  evento_id      String       @db.Uuid
  organizador_id String       @db.Uuid
  nota           Int
  comentario     String?
  criado_em      DateTime     @default(now()) @db.Timestamptz(6)
  eventos        eventos      @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fornecedores   fornecedores @relation(fields: [fornecedor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios       usuarios     @relation(fields: [organizador_id], references: [id], onUpdate: NoAction)

  @@unique([evento_id, fornecedor_id], map: "uq_avaliacao_evento_fornecedor")
  @@index([fornecedor_id], map: "idx_avaliacoes_fornecedor")
}

model blocos_site_evento {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  site_id      String       @db.Uuid
  tipo_bloco   String       @db.VarChar(50)
  titulo       String?      @db.VarChar(180)
